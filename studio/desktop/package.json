{
  "name": "codeaerospace-studio-desktop",
  "productName": "CO.DE Studio",
  "version": "1.0.0",
  "description": "ManimStudio de escritorio: el estudio local, los exports por tema y proyecto, y una terminal con Claude Code.",
  "main": "src/main.cjs",
  "author": "Alan Rosas Palacios",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "icons": "node scripts/make-icons.mjs",
    "dist:linux": "electron-builder --linux dir AppImage",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "space.coderesearch.studio.desktop",
    "productName": "CO.DE Studio",
    "executableName": "code-studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/node-pty*/**"
    ],
    "linux": {
      "icon": "build/icons",
      "category": "AudioVideo",
      "synopsis": "ManimStudio de escritorio",
      "target": [
        "dir",
        "AppImage"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CO.DE Studio"
    }
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "electron@44.4.4": true
  }
}
