[Unit]
Description=ManimStudio backend (FastAPI, 127.0.0.1:3002)
After=network.target manimstudio-runner.service
Wants=manimstudio-runner.service

[Service]
Type=simple
User=manimstudio
Group=manimstudio
WorkingDirectory=/var/www/codeaerospace_contenido/studio/backend
EnvironmentFile=/etc/manimstudio/env
# Un solo worker: la cola de renders y el bus SSE viven en memoria del proceso.
ExecStart=/var/www/codeaerospace_contenido/studio/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 3002 --workers 1
Restart=always
RestartSec=3

# Hardening: proceso web-facing sin privilegios, sin acceso a docker.sock.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# animations y lessons: alta web de secciones/animaciones (escribe
# <categoria>/<NN>-<slug>.py y categories.yaml). manim_extensions solo se lee.
# guiones: narracion (md/txt/wav + estado.json). exports: las peliculas
# montadas (exports/peliculas/<project_id>/). Los dos directorios deben ser
# del usuario `manimstudio`: el contenedor de montaje corre con ese uid y
# escribe ahi el mp4.
ReadWritePaths=/var/www/codeaerospace_contenido/render_jobs /var/www/codeaerospace_contenido/studio/backend /var/www/codeaerospace_contenido/studio/content/animations /var/www/codeaerospace_contenido/studio/content/lessons /var/www/codeaerospace_contenido/guiones /var/www/codeaerospace_contenido/exports
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# 1 GiB desde R1 (voz sin GCP): Piper corre como subproceso del backend y
# onnxruntime + un modelo de 63 MB rondan 250 MB de pico dentro del cgroup.
MemoryMax=1024M

[Install]
WantedBy=multi-user.target
