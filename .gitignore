# Manim generated media (videos, rendered tex/text, cached partial movies)
media/
**/media/

# Video files
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Large/generated images
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
# Excepcion: los iconos de marca del frontend SI se versionan (los
# genera studio/frontend/tools/brand_icons.mjs y nginx los sirve desde
# dist/; sin ellos produccion se queda sin favicon en silencio).
!studio/frontend/public/*.png

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# ManimStudio
render_jobs
render_jobs.pre-migration-*/
# Guiones de audio: el texto (.md/.txt) se versiona, el audio no
guiones/**/*.wav
studio/backend/.env
studio/backend/manimstudio.db*
studio/frontend/node_modules/
studio/frontend/dist/
metrics_history.json*

# Credenciales GCP del asistente IA — JAMAS al repo
studio/backend/gcp-key.json
*.gcp-key.json

# Socket del runner en desarrollo local (studio/dev.sh)
.run/

# Permisos locales de Claude Code (por máquina, puede contener rutas/credenciales)
.claude/settings.local.json

# Cursos montados con narracion (mux.sh) — binarios, fuera del repo
exports
exports.pre-migration-*/
